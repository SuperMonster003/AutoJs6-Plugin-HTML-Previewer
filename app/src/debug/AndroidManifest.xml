<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Debug builds only: the empty host of the Compose tests that set their own content, in place of the exported
            androidx.activity.ComponentActivity of ui-test-manifest. Not exported; same theme as that activity.
        -->
        <activity
            android:name=".ComposeTestActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity
            android:name=".PreviewerAppearanceTestActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <provider
            android:name=".HtmlPreviewerTestContentProvider"
            android:authorities="io.github.supermonster003.autojs6.plugin.htmlpreviewer.test.documents"
            android:exported="false"
            android:grantUriPermissions="true" />
        <activity
            android:name=".HtmlPreviewerWebViewTestActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".HtmlPreviewerPreferencesProbeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:process=":preferences_probe"
            android:theme="@android:style/Theme.NoDisplay" />
    </application>

</manifest>
